# Kopieren nach .env und Werte ergänzen (siehe docs/zugangsdaten.md)
# Diese Datei ist im Repository: hier nur Platzhalter, niemals echte Zugangsdaten eintragen.

# Lokale Datenbank aus docker-compose.yml
DATABASE_URL=postgres://midnightsports:midnightsports@localhost:5432/midnightsports?sslmode=disable

GOOGLE_CLIENT_ID=deine-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dein-client-secret
# make dev: http://localhost:5173/api/auth/callback
# make run: http://localhost:8080/api/auth/callback
OAUTH_REDIRECT_URL=http://localhost:5173/api/auth/callback

# openssl rand -base64 32
SESSION_SECRET=hier-zufaelligen-wert-eintragen
# openssl rand -base64 32
QR_SIGNING_KEY=hier-zufaelligen-wert-eintragen

# Diese Emails erhalten immer die Rolle Admin (mehrere mit Komma trennen)
ADMIN_EMAIL=admin@example.com

# Login mit Apple lokal (optional, siehe docs/zugangsdaten.md). Braucht eine HTTPS OAUTH_REDIRECT_URL
# APPLE_TEAM_ID=ABCDE12345
# APPLE_LOGIN_CLIENT_ID=ch.midnightsports.login
# APPLE_LOGIN_KEY_ID=XYZ9876543
# APPLE_LOGIN_KEY_FILE=../secrets/apple-login.p8

# Login ohne Google, nur lokal verwenden
DEV_LOGIN=false

# Produktion und Demo (make deploy, make deploy-demo). Apple-Werte gelten für beide
# PROD_URL=https://midnightsports.example
# PROD_GOOGLE_CLIENT_ID=deine-client-id.apps.googleusercontent.com
# PROD_APPLE_TEAM_ID=ABCDE12345
# PROD_APPLE_PASS_TYPE_ID=pass.ch.midnightsports.app
# PROD_APPLE_LOGIN_CLIENT_ID=ch.midnightsports.login
# PROD_APPLE_LOGIN_KEY_ID=XYZ9876543
